# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Admin Seed Configuration (Local / Hackathon Development Only)
ADMIN_SEED_ENABLED=false
ADMIN_NAME=CitySeva Admin
ADMIN_EMAIL=admin@cityseva.org
ADMIN_PASSWORD=
